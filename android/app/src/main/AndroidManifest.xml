<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebView uses this capability to enter shouldInterceptRequest; every
         app URL is still served from the APK by OfflineAssetWebViewClient. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_tinroof"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_tinroof"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tinroof"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".AudioAssetProvider"
            android:authorities="${applicationId}.audio-assets"
            android:exported="false" />
    </application>

</manifest>
